{
  "version": 2,
  "commands": [
    {
      "name": "OpenVSP: Fit Model",
      "command": "wtype -M ctrl -k f -m ctrl"
    },
    {
      "name": "OpenVSP: Wireframe Toggle",
      "command": "wtype -k w"
    },
    {
      "name": "Screenshot Area",
      "command": "grim -g \"$(slurp)\" ~/Pictures/vsp-$(date +%s).png"
    },
    {
      "name": "Weylus: Start",
      "command": "systemctl --user start weylus"
    },
    {
      "name": "Weylus: Stop",
      "command": "systemctl --user stop weylus"
    },
    {
      "name": "Sketchpad: Start",
      "command": "systemctl --user start sketchpad"
    },
    {
      "name": "Sketchpad: Stop",
      "command": "systemctl --user stop sketchpad"
    }
  ]
}
